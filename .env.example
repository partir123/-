# 本仓库首跑配置：本地运行 Python 流程，使用 DeepSeek 云端模型。
# 复制为 .env 后，仅在本机填入真实 Key；不要提交 .env。
# 已有 .env 时请逐项修改，不要用模板覆盖真实配置。
LLM_PROVIDER=deepseek
LOCAL_LLM=deepseek-flash
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# 当前 DeepSeek 官方接口地址固定在 graph.py；不读取 DEEPSEEK_BASE_URL。
# USE_TOOL_CALLING=false 时，查询和反思使用 JSON，总结使用普通文本。
USE_TOOL_CALLING=false
STRIP_THINKING_TOKENS=true

# 使用 ddgs==9.16.0 的 DuckDuckGo 后端；无须额外的搜索 API Key。
SEARCH_API=duckduckgo
# 当前代码先执行一次检索，再判断是否继续；0 表示首跑只检索一次。
MAX_WEB_RESEARCH_LOOPS=0
# 首跑只使用搜索摘要，暂不抓取网页全文。
FETCH_FULL_PAGE=false

# 首跑不启用远程追踪。
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# 以下为可选配置。切换模型时修改上面的 LLM_PROVIDER、LOCAL_LLM，勿重复定义。
# LLM_PROVIDER 的可选值：deepseek、ollama、lmstudio。
# Ollama 示例：LOCAL_LLM=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# LMStudio 的 LOCAL_LLM 应使用其服务实际加载的模型名称。
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# 其他搜索后端：修改上面的 SEARCH_API 后，再填写对应配置。
# SEARCH_API 的可选值：duckduckgo、tavily、perplexity、searxng。
# TAVILY_API_KEY=YOUR_TAVILY_API_KEY
# PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
# SEARXNG_URL=http://localhost:8888
